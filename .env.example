# Copy to .env (the devcontainer post-create step does this automatically).
# Placeholders and local development values only — never commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Development database: the MongoDB replica set from .devcontainer/docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB_NAME=clinc_dev

# Base URI for isolated test databases. Tests create uniquely named
# "*_test_*" databases on this server and drop them when finished.
MONGODB_TEST_URI=mongodb://localhost:27017/?directConnection=true

# Sessions: opaque server-side sessions in an HttpOnly cookie.
SESSION_TTL_HOURS=168
# Must be true in production (HTTPS only). false is fine for local http://127.0.0.1.
SESSION_COOKIE_SECURE=false
# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false
# Extra origins allowed to send state-changing requests (comma separated). The request's
# own host is always allowed, so the Vite proxy and Codespaces preview need nothing here.
APP_ORIGINS=

# Login/registration attempts allowed per IP per window.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Password for the synthetic demo accounts created by `npm run seed` (development only).
# The devcontainer generates a random value here; leave empty to get a one-off password
# printed by the seed command instead.
DEMO_PASSWORD=

# The Vite dev server proxies /api requests to this address.
API_PROXY_TARGET=http://127.0.0.1:4000
