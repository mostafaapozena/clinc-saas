# Copy to .env (the devcontainer post-create step does this automatically).
# Placeholders and local development values only — never commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Development database: a MongoDB replica set. In the Codespace, docker-compose.yml sets
# MONGODB_URI / MONGODB_TEST_URI to the "mongo" service, overriding these localhost values.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB_NAME=clinc_dev

# Base URI for isolated test databases. Tests create uniquely named
# "*_test_*" databases on this server and drop them when finished.
MONGODB_TEST_URI=mongodb://localhost:27017/?directConnection=true

# Sessions: opaque server-side sessions in an HttpOnly cookie.
SESSION_TTL_HOURS=168
# Must be true in production (HTTPS only). false is fine for local http://127.0.0.1.
SESSION_COOKIE_SECURE=false
# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false
# Extra origins allowed to send state-changing requests (comma separated). The request's
# own host is always allowed, so the Vite proxy and Codespaces preview need nothing here.
APP_ORIGINS=

# Login/registration attempts allowed per IP per window.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Per IP and hour: organization creation / onboarding completion, and public custom-project requests.
SETUP_RATE_LIMIT_MAX=20
INQUIRY_RATE_LIMIT_MAX=5

# Public website (read by the web build, not by the API). Leave both unset for development, the
# private Codespaces preview and staging: everything is then noindex. Set both only for the real
# public site, e.g. VITE_PUBLIC_SITE_URL=https://example.com and VITE_PUBLIC_INDEXING=true.
# VITE_PUBLIC_SITE_URL=
# VITE_PUBLIC_INDEXING=

# Password for the synthetic demo accounts created by `npm run seed` (development only).
# The devcontainer generates a random value here; leave empty to get a one-off password
# printed by the seed command instead.
DEMO_PASSWORD=

# The Vite dev server proxies /api requests to this address.
API_PROXY_TARGET=http://127.0.0.1:4000

# Clinical-lead coverage grants stay off until the owner decides who holds that authority (B1).
CLINICAL_LEAD_GRANTS_ENABLED=false

# Platform subscriptions (milestone 4). "simulator" is a clearly labelled payment SIMULATOR for
# development and tests (refused in production); "none" disables online subscription payments.
# No real payment provider is integrated yet (decision B5).
BILLING_PROVIDER=simulator
# Optional HMAC secret (32+ characters) for simulator webhooks; random per process when empty.
BILLING_SIMULATOR_SECRET=
# Entitlement enforcement: off | log | on. Keep "off" until the owner decides the policy (B4).
SUBSCRIPTION_ENFORCEMENT=off
